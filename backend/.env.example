# Copy to .env:  cp .env.example .env
# Never commit .env — it holds secrets.

# --- Required ---
PORT=3000
MONGO_URL=mongodb://localhost:27017/finsight
JWT_SECRET=replace-with-a-long-random-secret-min-64-chars

# --- AI: Anthropic (production) OR mock (free local demo) ---
# Mock mode: no API key or credits needed — analysis/chat use heuristics from your CSV
AI_PROVIDER=mock
MOCK_CLAUDE=true
# For real Claude: AI_PROVIDER=anthropic, MOCK_CLAUDE=false, and set:
# ANTHROPIC_API_KEY=your-anthropic-api-key-from-console-anthropic-com

# --- Production ---
# Comma-separated frontend URLs (for CORS), e.g. https://finsightai.com,https://www.finsightai.com
CORS_ORIGINS=http://localhost:4200

# --- Optional (defaults shown) ---
JWT_EXPIRES_IN=7d

# --- Not used by the app yet (safe to omit) ---
REDIS_HOST=localhost
REDIS_PORT=6379